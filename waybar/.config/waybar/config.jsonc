// https://github.com/Alexays/Waybar/wiki
{
    //"layer": "top",
    "position": "top",
    "reload_style_on_change": true,
    "spacing": 2,
    // Margins match hyprland.lua general.gaps_in/gaps_out (5px)
    "margin-top": 5,
    "margin-left": 5,
    "margin-right": 5,
    // Separate groups/modules so the spotify controller and the VPN
    // indicator each render as their own island
    "modules-left": ["group/leftisland", "custom/vpn", "group/spotify", "tray"],
    // Invisible (see style.css) — it exists only so waybar owns
    // org.kde.StatusNotifierWatcher on the session bus. The Proton VPN app
    // probes that name at startup; when it's there the window's x button
    // hides the window instead of quitting the app, so the VPN keeps running
    // in the background. The custom/vpn island is the actual indicator, so
    // the tray icon itself is shrunk away. To show real tray icons instead,
    // drop the icon-size below and the #tray rule in style.css.
    "tray": {
        "icon-size": 1,
        "spacing": 0
    },
    "group/leftisland": {
        "orientation": "inherit",
        "modules": ["custom/archlogo", "hyprland/workspaces"]
    },
    // VPN island — always visible: the script prints the connected country
    // when a tunnel is up and a dimmed "[VPN]" otherwise
    "custom/vpn": {
        "exec": "$HOME/.config/waybar/scripts/vpn.sh",
        "return-type": "json",
        "format": "<span size='12000' rise='-2000'>󰦝</span> {}",
        "interval": 5,
        // focus the Proton VPN window, or launch the app if it has none
        "on-click": "$HOME/.config/waybar/scripts/vpn.sh click"
    },
    "group/spotify": {
        "orientation": "inherit",
        "modules": ["custom/spotify-prev", "custom/spotify-toggle", "custom/spotify-next", "custom/spotify"]
    },
    "modules-center": [],
    "modules-right": ["custom/screenshare", "custom/wallpaper", "cpu", "memory", "pulseaudio", "backlight", "bluetooth", "network", "battery", "clock#date", "clock#time"],
    // Only visible while an HDMI/DP cable is connected; click opens a
    // wofi menu to mirror or extend (extend parks workspace 10 on the
    // external screen). Signal 9 refreshes right after a menu action.
    "custom/screenshare": {
        "exec": "$HOME/.config/waybar/scripts/screenshare.sh",
        "return-type": "json",
        "interval": 3,
        "signal": 9,
        "on-click": "$HOME/.config/waybar/scripts/screenshare.sh menu"
    },
    // Wallpaper + theme island: icon is tinted with the theme accent and the
    // tooltip names the theme. `theme` SIGUSR2-reloads waybar on every switch,
    // which re-runs this exec, so "once" is enough.
    "custom/wallpaper": {
        "exec": "$HOME/.local/bin/theme waybar",
        "return-type": "json",
        "interval": "once",
        // wofi thumbnail picker over all themes; picking another theme's
        // wallpaper switches theme, and resets the cycler timer either way
        "on-click": "$HOME/.config/waybar/scripts/wallpaper-select.sh",
        "on-click-right": "$HOME/.local/bin/theme next"
    },
    "custom/archlogo": {
        "format": "󰣇",
        "tooltip": false,
        "on-click": "wofi --show drun"
    },
    // Spotify controller — modules emit nothing when Spotify is closed,
    // so the whole group hides. Signal 8 forces an instant refresh on click.
    "custom/spotify": {
        "exec": "$HOME/.config/waybar/scripts/spotify.sh info",
        "return-type": "json",
        "interval": 2,
        "signal": 8,
        "max-length": 45,
        // hop to the workspace spotify lives on
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ window = \"class:^(Spotify)$\" })'"
    },
    "custom/spotify-prev": {
        "exec": "$HOME/.config/waybar/scripts/spotify.sh prev",
        "return-type": "json",
        "interval": 2,
        "signal": 8,
        "tooltip": false,
        "on-click": "playerctl -p spotify previous && pkill -RTMIN+8 waybar"
    },
    "custom/spotify-toggle": {
        "exec": "$HOME/.config/waybar/scripts/spotify.sh toggle",
        "return-type": "json",
        "interval": 2,
        "signal": 8,
        "tooltip": false,
        "on-click": "playerctl -p spotify play-pause && pkill -RTMIN+8 waybar"
    },
    "custom/spotify-next": {
        "exec": "$HOME/.config/waybar/scripts/spotify.sh next",
        "return-type": "json",
        "interval": 2,
        "signal": 8,
        "tooltip": false,
        "on-click": "playerctl -p spotify next && pkill -RTMIN+8 waybar"
    },
    "cpu": {
        "format": "<span size='12000' rise='-2000'></span> {usage}%",
        "interval": 2,
        "tooltip": true,
        // Toggles the per-core bar chart dropdown under the bar
        "on-click": "python3 $HOME/.config/waybar/scripts/cpu-cores-dropdown.py"
    },
    "memory": {
        "format": "<span size='12000' rise='-2000'></span> {percentage}%",
        "interval": 2,
        "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB used\nSwap: {swapUsed:0.1f} / {swapTotal:0.1f} GiB"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "<span size='12000' rise='-2000'></span> ",
        "format-icons": {
            "headphone": "<span size='12000' rise='-2000'></span>",
            "default": ["<span size='12000' rise='-2000'></span>", "<span size='12000' rise='-2000'></span>", "<span size='12000' rise='-2000'></span>"]
        },
        "on-click": "pavucontrol"
    },
    "backlight": {
        "format": "<span size='12000' rise='-2000'>󰖨</span> {}%",
        "tooltip": false
    },
    "bluetooth": {
        // The Material bluetooth glyphs fill their whole em-box, so at the
        // shared 12000 size they render ~21px tall vs 13-17px for the other
        // icons; 9500 matches the round ones (sun, clock). The zero-width
        // space at 12000 anchors the baseline — with the glyph alone in the
        // label (the off state) GTK re-centers the box and `rise` does nothing
        "format-on": "<span size='9500' rise='1000'>󰂯</span><span size='12000'>​</span>",
        "format-off": "<span size='9500' rise='1000'>󰂲</span><span size='12000'>​</span>",
        "format-disabled": "<span size='9500' rise='1000'>󰂲</span><span size='12000'>​</span>",
        "format-connected": "<span size='9500' rise='1000'>󰂯</span><span size='12000'>​</span> {device_alias}",
        "format-connected-battery": "<span size='9500' rise='1000'>󰂯</span><span size='12000'>​</span> {device_alias}",
        "format-no-controller": "",
        "tooltip-format": "{num_connections} connected",
        "tooltip-format-connected": "{num_connections} connected\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%",
        // Toggle bluetooth
        "on-click": "bluetoothctl show | grep 'Powered:' | grep -q 'yes' && bluetoothctl power off || bluetoothctl power on",
        "on-click-right": "blueman-manager"
    }, 
    "network": {
        // Pin to the wifi interface: without this the module follows the
        // default route, which jumps to proton0 while the VPN is up and
        // swaps the wifi icon for the 󰖂 "linked" one
        "interface": "wl*",
        "format-wifi": "{icon}{essid}",
        "format-icons": ["<span size='12000' rise='-2000'>󰤯</span> ", "<span size='12000' rise='-2000'>󰤟</span> ", "<span size='12000' rise='-2000'>󰤢</span> ", "<span size='12000' rise='-2000'>󰤥</span> ", "<span size='12000' rise='-2000'>󰤨</span> "],
        "format-linked": "<span size='12000' rise='-2000'>󰖂</span> ",
        "format-ethernet": "<span size='12000' rise='-2000' foreground='#f5e0dc'>🖧</span>",
        "format-disconnected": "<span size='12000' rise='-2000' foreground='#f5e0dc'>󰤭</span> Disconnected",
        "tooltip-format-wifi": "Signal strength: {signalStrength}%\n{bandwidthDownBits}",
        "tooltip-format-linked": "{ifname} 󰖂 \n{bandwidthDownBits}",
        "tooltip-format-ethernet": "{ifname} 🖧\n{bandwidthDownBits}",
        "interval": 10,
        // --class gives the window its own Hyprland opacity rule (see
        // hyprland.lua); kitty's own 0.45 bg opacity is reset to 1.0 so the
        // rule's opacity is the only transparency, like the other programs
        "on-click": "kitty --class nmtui -o background_opacity=1.0 nmtui"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 20,
            "danger": 10
        },
        "format": "<span size='12000' rise='-2000'>{icon}</span> {capacity}%",
        "format-charging": "<span size='12000' rise='-2000'></span> {capacity}%",
        "format-plugged": "<span size='12000' rise='-2000'></span> {capacity}%",
        "format-alt": "<span size='12000' rise='-2000'>{icon}</span> {time}",
        "format-full": "<span size='12000' rise='-2000'>{icon}</span> {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "interval": 1
    },
    "clock#date": {
        "format": "<span size='12000' rise='-2000' foreground='#eba0ac'></span> {:%Y-%m-%d}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "interval": 60,
        "calendar": {
            "format": {
                "months":     "<span color='#ffead3'><b>{}</b></span>",
                "days":       "<span color='#ecc6d9'><b>{}</b></span>",
                "weeks":      "<span color='#99ffdd'><b> {}</b></span>",
                "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
                "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
            },
            "weeks-pos": "right"
        }
    },
    "clock#time": {
        "format": "<span size='12000' rise='-2000' foreground='#eba0ac'></span> {:%T}",
        "tooltip": false,
        "interval": 1
    }
}
