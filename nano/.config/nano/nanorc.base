# The non-colour half of nano's config. The real ~/.config/nano/nanorc is
# generated by ~/.local/bin/theme: the theme's interface colours + this file.
# (nanorc `include` only takes syntax files and bans `set`, so the colours
# can't live in an included file — same reason wofi gets a generated css.)
# Edit here, then run `theme apply` to regenerate.

# Syntax highlighting from nano's stock definitions — their colours are
# ANSI-ish names, so they ride the terminal palette kitty already themes.
include "/usr/share/nano/*.nanorc"
