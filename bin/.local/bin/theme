#!/usr/bin/env bash
# Desktop theme switcher. A theme is a dark palette in ~/.config/themes/NAME.theme
# plus the wallpapers in ~/Pictures/Wallpaper/NAME/ — the themes differ only in
# undertone and accent, never in light/dark. Switching regenerates the palette
# css that waybar and wofi import, recolours Hyprland's borders and shows a
# wallpaper from the new theme.
#
#   theme                 print the current theme
#   theme list            list the themes
#   theme label [NAME]    display name of NAME (default: current)
#   theme set NAME        switch to NAME and show one of its wallpapers
#   theme next            switch to the next theme and show one of its
#                         wallpapers (waybar right-click)
#   theme apply           re-apply the current palette without touching the
#                         wallpaper (install.sh runs this to generate the css)
#   theme images [NAME]   wallpapers of NAME (default: current), one per line
#   theme wallpaper IMG   show IMG, switching theme first if IMG is in another
#                         theme's folder
#   theme waybar          status JSON for waybar's custom/wallpaper module
set -uo pipefail

THEMES_DIR="$HOME/.config/themes"
WALLPAPER_DIR="$HOME/Pictures/Wallpaper"
# Fixed path (not $XDG_STATE_HOME): hyprland.lua reads the same file and must
# agree on where it is regardless of which environment either runs in.
STATE_DIR="$HOME/.local/state/theme"
# waybar @imports "theme.css", which GTK resolves next to the (symlinked)
# style.css, so it's a plain generated file beside the repo links. wofi loads
# its css as a string, where a relative @import can't work, so it gets a
# complete generated style.css: the palette + the rules in style.base.css.
WAYBAR_CSS="$HOME/.config/waybar/theme.css"
WOFI_CSS="$HOME/.config/wofi/style.css"
WOFI_BASE="$HOME/.config/wofi/style.base.css"
# Catppuccin Mocha's full palette; each theme then overrides the neutrals.
MOCHA_CSS="$HOME/.config/waybar/mocha.css"
# SDDM's sugar-candy theme shows this file as the login background; keep it in
# sync with the wallpaper. Needs a one-time `sudo chown $USER` (see README) —
# silently skipped otherwise. Qt loads by content, so non-jpg sources are fine.
SDDM_BG="/usr/share/sddm/themes/sugar-candy/Backgrounds/current.jpg"
NEUTRALS=(text subtext1 subtext0 overlay2 overlay1 overlay0
          surface2 surface1 surface0 base mantle crust)

die() { echo "theme: $*" >&2; exit 1; }

themes() {
    local f
    for f in "$THEMES_DIR"/*.theme; do
        [ -e "$f" ] && basename "$f" .theme
    done
}

is_theme() { [ -n "${1:-}" ] && [ -f "$THEMES_DIR/$1.theme" ]; }

# Which theme an image belongs to: the name of the folder it sits in, or —
# for a path from before the wallpapers were sorted into theme folders — the
# theme folder holding a file of the same name.
theme_of() {
    local dir t
    dir="$(basename "$(dirname "$1")")"
    if is_theme "$dir"; then
        printf '%s\n' "$dir"
        return
    fi
    for t in $(themes); do
        [ -e "$WALLPAPER_DIR/$t/$(basename "$1")" ] && { printf '%s\n' "$t"; return; }
    done
    return 1
}

# Saved theme if it still exists; else the theme of the wallpaper hyprpaper is
# showing (so a first run matches the screen); else the first alphabetically.
current() {
    local saved="" shown
    [ -r "$STATE_DIR/current" ] && read -r saved < "$STATE_DIR/current"
    if is_theme "$saved"; then
        printf '%s\n' "$saved"
        return
    fi
    shown="$(hyprctl hyprpaper listactive 2>/dev/null | sed -n '1s/^[^:]*: //p')"
    [ -n "$shown" ] && saved="$(theme_of "$shown")"
    if is_theme "$saved"; then
        printf '%s\n' "$saved"
    else
        themes | head -n1
    fi
}

# Parse NAME.theme into the associative array T (KEY=VALUE lines).
declare -A T
load() {
    is_theme "$1" || die "no such theme: $1 (have: $(themes | tr '\n' ' '))"
    T=()
    local key value
    while IFS='=' read -r key value; do
        case "$key" in ''|\#*) continue ;; esac
        value="${value%\"}"; value="${value#\"}"
        T[$key]=$value
    done < "$THEMES_DIR/$1.theme"
    T[name]=$1
    : "${T[label]:=$1}"
}

images() {
    find -L "$WALLPAPER_DIR/$1" -maxdepth 1 -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
           -o -iname '*.webp' -o -iname '*.gif' -o -iname '*.bmp' \) 2>/dev/null | sort
}

# Write $2 to file $1 atomically (so waybar/wofi never read a half-written file).
write_file() {
    mkdir -p "$(dirname "$1")"
    printf '%s' "$2" > "$1.tmp" && mv -f "$1.tmp" "$1"
}

write_css() {
    local palette key
    palette="$(
        echo "/* Generated by ~/.local/bin/theme from ~/.config/themes/${T[name]}.theme"
        echo "   (+ ~/.config/wofi/style.base.css for wofi). Edit those, not this. */"
        echo
        [ -r "$MOCHA_CSS" ] && cat "$MOCHA_CSS"
        echo
        echo "/* ${T[label]}: undertone neutrals + accent (later definitions win) */"
        for key in "${NEUTRALS[@]}" accent; do
            [ -n "${T[$key]:-}" ] && echo "@define-color $key #${T[$key]};"
        done
    )"
    write_file "$WAYBAR_CSS" "$palette"$'\n'
    if [ -r "$WOFI_BASE" ]; then
        write_file "$WOFI_CSS" "$palette"$'\n\n'"$(cat "$WOFI_BASE")"$'\n'
    fi
}

# Palette only: css files, saved state, live Hyprland borders, waybar reload.
apply() {
    load "$1"
    write_css
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$1" > "$STATE_DIR/current"
    if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        hyprctl eval "hl.config({ general = { col = {
            active_border   = 'rgba(${T[accent]}ee)',
            inactive_border = 'rgba(${T[surface2]}aa)',
        } } })" >/dev/null 2>&1
    fi
    # SIGUSR2 = full waybar reload: picks up the new theme.css and re-runs the
    # custom/wallpaper module so its tooltip shows the new theme
    pkill -USR2 -x waybar 2>/dev/null
    return 0
}

set_wallpaper() {
    local img=$1 mon
    [ -f "$img" ] || die "not a file: $img"
    while read -r mon; do
        [ -n "$mon" ] && hyprctl hyprpaper wallpaper "$mon,$img" >/dev/null 2>&1
    done < <(hyprctl monitors 2>/dev/null | awk '/^Monitor/{print $2}')
    [ -w "$SDDM_BG" ] && cp -f "$img" "$SDDM_BG"
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$img" > "$STATE_DIR/wallpaper"
}

# Restart the cycler's timer so a wallpaper picked here stays up a full
# interval (no-op if the cycler isn't running). Matches the cycler's exact
# command line: a looser `pkill -f wallpaper-cycle.sh` also hits anything that
# merely mentions the script (an editor, a pager), and USR1 kills those.
nudge_cycler() {
    pkill -USR1 -fx '(/usr/bin/)?bash .*/wallpaper-cycle\.sh' 2>/dev/null
    return 0
}

# A random wallpaper of the theme, avoiding the one currently shown.
random_image() {
    local last="" list
    [ -r "$STATE_DIR/wallpaper" ] && read -r last < "$STATE_DIR/wallpaper"
    mapfile -t list < <(images "$1")
    (( ${#list[@]} )) || return 1
    if (( ${#list[@]} > 1 )); then
        mapfile -t list < <(printf '%s\n' "${list[@]}" | grep -vxF -- "$last")
    fi
    printf '%s\n' "${list[RANDOM % ${#list[@]}]}"
}

switch_to() {
    local img
    # Wallpaper before palette: apply() ends in a SIGUSR2 waybar reload, and
    # waybar kills a click command's process group when its modules are torn
    # down — anything after that signal never runs when this was started from
    # the bar's right-click.
    if img="$(random_image "$1")"; then
        set_wallpaper "$img"
        nudge_cycler
    fi
    apply "$1"
}

cmd="${1:-current}"
case "$cmd" in
    current) current ;;
    list)    themes ;;
    label)   load "${2:-$(current)}"; printf '%s\n' "${T[label]}" ;;
    set)     switch_to "${2:?usage: theme set NAME}" ;;
    next)
        mapfile -t all < <(themes)
        (( ${#all[@]} )) || die "no themes in $THEMES_DIR"
        cur="$(current)" next="${all[0]}"
        for i in "${!all[@]}"; do
            [ "${all[i]}" = "$cur" ] && next="${all[(i + 1) % ${#all[@]}]}"
        done
        switch_to "$next"
        ;;
    apply)   apply "$(current)" ;;
    images)  images "${2:-$(current)}" ;;
    wallpaper)
        img="${2:?usage: theme wallpaper IMG}"
        t="$(theme_of "$img")"
        # same ordering as switch_to: apply's waybar reload may kill us, so
        # the wallpaper and the cycler nudge come first
        set_wallpaper "$img"
        nudge_cycler
        [ -n "$t" ] && [ "$t" != "$(current)" ] && apply "$t"
        ;;
    waybar)
        load "$(current)"
        # label is our own file's text; still escape it for JSON
        label=${T[label]//\\/\\\\}; label=${label//\"/\\\"}
        printf '{"text":"<span size='\''12000'\'' rise='\''-2000'\''>󰋩</span>","tooltip":"Theme: %s\\nclick: pick a wallpaper\\nright-click: next theme","class":"%s"}\n' \
            "$label" "${T[name]}"
        ;;
    -h|--help|help) sed -n '2,19p' "$0" | sed 's/^# \?//' ;;
    *) die "unknown command: $cmd (try: theme --help)" ;;
esac
