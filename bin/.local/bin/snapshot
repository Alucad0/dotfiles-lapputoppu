#!/usr/bin/env bash
# Quick full screenshot without selection (SUPER+SHIFT+P in hyprland.lua —
# SUPER+P belongs to the F7 display key, which sends that combo); the
# image also lands on the clipboard (and in the SUPER+H cliphist history)
set -euo pipefail
out="$HOME/Pictures/screenshots"
mkdir -p "$out"
file="$out/snapshot_$(date +%Y%m%d_%H%M%S).png"
grim "$file"
wl-copy --type image/png < "$file"
